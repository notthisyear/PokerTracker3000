<UserControl x:Class="PokerTracker3000.WpfComponents.ScrollingCollectionViewItemsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="mainGrid"
          DataContext="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=.}"
          VerticalAlignment="Stretch"
          Margin="5">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="25" />
        </Grid.ColumnDefinitions>
        
        <!-- Main content -->
        <Canvas x:Name="mainPanel"
                VerticalAlignment="Stretch" />

        <!-- Elements available up and down visualization -->
        <Grid HorizontalAlignment="Right"
              Grid.Column="1">
            <Grid.Resources>
                <Style x:Key="upAndDownButtonStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SymbolButtonStyle}">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="Width" Value="25" />
                    <Setter Property="FontSize" Value="20" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="{StaticResource MainTextColor}" />
                    <Setter Property="Opacity" Value="0.6" />
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="&#xE70E;"
                       VerticalAlignment="Top">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource upAndDownButtonStyle}">
                        <Setter Property="Opacity" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=HasElementsAboveTop}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource animateOpacityToPointSix}" />
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource animateOpacityToZero}" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Row="1"
                       Text="&#xE70D;"
                       VerticalAlignment="Bottom">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource upAndDownButtonStyle}">
                        <Setter Property="Opacity" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=HasElementsBelowLast}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource animateOpacityToPointSix}" />
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource animateOpacityToZero}" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
