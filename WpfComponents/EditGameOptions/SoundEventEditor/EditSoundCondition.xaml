<editgameoptions:ConditionAndEffectEditorBase x:Class="PokerTracker3000.WpfComponents.EditGameOptions.EditSoundCondition"
                                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                              xmlns:components="clr-namespace:PokerTracker3000.WpfComponents"
                                              xmlns:editgameoptions="clr-namespace:PokerTracker3000.WpfComponents.EditGameOptions">

    <Grid DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}, Path=.}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="15" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Style x:Key="scrollerStyle" TargetType="{x:Type components:ScrollingSelectorBox}">
                <Setter Property="OptionTextAlignment" Value="Left" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="VerticalSpacing" Value="20" />
                <Setter Property="NextAndPreviousOpacity" Value="0.0" />
                <Setter Property="WrapAtEnds" Value="True" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <Style x:Key="tableHeadlineText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MainTextBlockStyle}">
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.6" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
        </Grid.Resources>

        <!-- Condition variable scroller -->
        <TextBlock Text="Trigger on">
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource tableHeadlineText}">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsActive}" Value="True" />
                                <Condition Binding="{Binding Path=SelectedInputColumn}" Value="0" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource animateOpacityToZero}" />
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource animateOpacityToPointSix}" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <components:ScrollingSelectorBox x:Name="conditionVariableScroller"
                                         Grid.Column="0"
                                         Grid.Row="1"
                                         VerticalAlignment="Center"
                                         Options="{Binding Path=AvailableConditionVariables}"
                                         NavigatorRelay="{Binding Path=ConditionVariableNavigator}"
                                         Foreground="{StaticResource MainTextColor}">
            <components:ScrollingSelectorBox.Style>
                <Style TargetType="{x:Type components:ScrollingSelectorBox}" BasedOn="{StaticResource scrollerStyle}">
                    <Setter Property="CenterItemColor" Value="{StaticResource MainTextColor}" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsActive}" Value="True" />
                                <Condition Binding="{Binding Path=SelectedInputColumn}" Value="0" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.Setters>
                                <Setter Property="CenterItemColor" Value="{StaticResource MainHighlightColor}" />
                                <Setter Property="NextAndPreviousOpacity" Value="0.1" />
                            </MultiDataTrigger.Setters>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </components:ScrollingSelectorBox.Style>
        </components:ScrollingSelectorBox>
        
        <!-- Condition check type scroller -->
        <TextBlock Text="Condition"
                   Grid.Column="1">
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource tableHeadlineText}">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsActive}" Value="True" />
                                <Condition Binding="{Binding Path=SelectedInputColumn}" Value="1" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource animateOpacityToZero}" />
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource animateOpacityToPointSix}" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <components:ScrollingSelectorBox x:Name="conditionCheckScroller"
                                         Grid.Column="1"
                                         Grid.Row="1"
                                         VerticalAlignment="Center"
                                         Options="{Binding Path=AvailableConditionCheckTypes}"
                                         NavigatorRelay="{Binding Path=ConditionCheckNavigator}"
                                         Foreground="{StaticResource MainTextColor}">
            <components:ScrollingSelectorBox.Style>
                <Style TargetType="{x:Type components:ScrollingSelectorBox}" BasedOn="{StaticResource scrollerStyle}">
                    <Setter Property="CenterItemColor" Value="{StaticResource MainTextColor}" />
                    <Setter Property="FontSize" Value="16" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsActive}" Value="True" />
                                <Condition Binding="{Binding Path=SelectedInputColumn}" Value="1" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.Setters>
                                <Setter Property="CenterItemColor" Value="{StaticResource MainHighlightColor}" />
                                <Setter Property="NextAndPreviousOpacity" Value="0.1" />
                            </MultiDataTrigger.Setters>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </components:ScrollingSelectorBox.Style>
        </components:ScrollingSelectorBox>
       
        <!-- Game event scroller -->
        <TextBlock Grid.Column="2">
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource tableHeadlineText}">
                    <Setter Property="Text" Value="Event" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=IsGameEventType}" Value="False">
                            <Setter Property="Text" Value="Value" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsActive}" Value="True" />
                                <Condition Binding="{Binding Path=SelectedInputColumn}" Value="2" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource animateOpacityToZero}" />
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource animateOpacityToPointSix}" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <components:ScrollingSelectorBox x:Name="gameEventScroller"
                                         Grid.Column="2"
                                         Grid.Row="1"
                                         VerticalAlignment="Center"
                                         Options="{Binding Path=AvailableGameEventTypes}"
                                         NavigatorRelay="{Binding Path=GameEventNavigator}"
                                         Foreground="{StaticResource MainTextColor}">
            <components:ScrollingSelectorBox.Style>
                <Style TargetType="{x:Type components:ScrollingSelectorBox}" BasedOn="{StaticResource scrollerStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="CenterItemColor" Value="{StaticResource MainTextColor}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=IsGameEventType}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsActive}" Value="True" />
                                <Condition Binding="{Binding Path=SelectedInputColumn}" Value="2" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.Setters>
                                <Setter Property="CenterItemColor" Value="{StaticResource MainHighlightColor}" />
                                <Setter Property="NextAndPreviousOpacity" Value="0.1" />
                            </MultiDataTrigger.Setters>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </components:ScrollingSelectorBox.Style>
        </components:ScrollingSelectorBox>

        <!-- Text input -->
        <TextBox x:Name="valueEditBox"
                 Text="{Binding Path=CurrentValue, UpdateSourceTrigger=PropertyChanged}"
                 Grid.Column="2"
                 Grid.Row="1"
                 VerticalAlignment="Center"
                 VerticalContentAlignment="Center"
                 HorizontalAlignment="Left"
                 Padding="5,0,0,0"
                 Width="120"
                 Height="25">
            <TextBox.Style>
                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MainTextBoxStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=IsGameEventType}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>
        
        <!-- Option info and validation -->
        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Grid.ColumnSpan="3"
                    Grid.Row="2">
            <TextBlock Margin="0,10,15,10">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MainTextBlockStyle}">
                        <Setter Property="Text" Value="What game event to trigger on" />
                        <Setter Property="FontSize" Value="10" />
                        <Setter Property="Opacity" Value="0.6" />
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="HorizontalAlignment" Value="Right" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=SelectedInputColumn}" Value="0">
                                <Setter Property="Text" Value="What event to trigger on" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=SelectedInputColumn}" Value="1">
                                <Setter Property="Text" Value="What condition to trigger on" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </DataTrigger>

                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Path=IsActive}" Value="True" />
                                    <Condition Binding="{Binding Path=RemoveConditionModel.IsSelected}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.Setters>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </MultiDataTrigger.Setters>
                            </MultiDataTrigger>

                            <DataTrigger Binding="{Binding Path=IsActive}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        
            <!-- Validation -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=IsActive}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MainTextBlockStyle}">
                            <Setter Property="Text" Value="Condition is valid" />
                            <Setter Property="FontSize" Value="10" />
                            <Setter Property="Foreground" Value="{StaticResource MainSuccessColor}" />
                            <Setter Property="FontStyle" Value="Italic" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=IsValid}" Value="False">
                                    <Setter Property="Text" Value="{Binding Path=ValidationInfo, StringFormat='Condition invalid - {0}'}" />
                                    <Setter Property="Foreground" Value="{StaticResource MainErrorColor}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </StackPanel>
        
        <!-- Remove buttons -->
        <components:ButtonOptionBox OptionModel="{Binding Path=RemoveConditionModel}"
                                    HorizontalAlignment="Center"
                                    Grid.Column="3"
                                    Grid.Row="1"
                                    Width="95"/>
    </Grid>
</editgameoptions:ConditionAndEffectEditorBase>
