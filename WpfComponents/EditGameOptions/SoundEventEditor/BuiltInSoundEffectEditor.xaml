<editgameoptions:SoundEffectEditorBase x:Class="PokerTracker3000.WpfComponents.EditGameOptions.BuiltInSoundEffectEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:PokerTracker3000.WpfComponents"
             xmlns:editgameoptions="clr-namespace:PokerTracker3000.WpfComponents.EditGameOptions">
    <Grid DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}, Path=.}"
          HorizontalAlignment="Center"
          Margin="10,0,10,0">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        
        <!-- Headline -->
        <TextBlock Style="{StaticResource MainTextBlockStyle}"
                   FontSize="10"
                   Opacity="0.8"
                   HorizontalAlignment="Center"
                   FontWeight="Bold"
                   Text="Built-in sound effect" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Grid.Row="1"
                    Margin="0,20,0,30">

            <!-- Info text -->
            <TextBlock Style="{StaticResource MainTextBlockStyle}"
                       Text="Effect:"
                       Margin="0,0,10,0"
                       Opacity="0.7"
                       FontSize="11"
                       VerticalAlignment="Center"/>

            <!-- Scroller -->
            <components:ScrollingSelectorBox x:Name="builtInSoundEffectScroller"
                                             VerticalAlignment="Center"
                                             Options="{Binding Path=AvailableBuiltInSoundEffectTypes}"
                                             NavigatorRelay="{Binding Path=ScrollerNavRelay}"
                                             Foreground="{StaticResource MainTextColor}">
                <components:ScrollingSelectorBox.Style>
                    <Style TargetType="{x:Type components:ScrollingSelectorBox}">
                        <Setter Property="CenterItemColor" Value="{StaticResource MainTextColor}" />
                        <Setter Property="Foreground" Value="{StaticResource MainTextMutedColor}" />
                        <Setter Property="OptionTextAlignment" Value="Center" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="VerticalSpacing" Value="20" />
                        <Setter Property="NextAndPreviousOpacity" Value="0.0" />
                        <Setter Property="WrapAtEnds" Value="False" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Path=IsActive}" Value="True" />
                                    <Condition Binding="{Binding Path=ScrollerSelectable.IsSelected}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.Setters>
                                    <Setter Property="CenterItemColor" Value="{StaticResource MainHighlightColor}" />
                                    <Setter Property="NextAndPreviousOpacity" Value="0.1" />
                                </MultiDataTrigger.Setters>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </components:ScrollingSelectorBox.Style>
            </components:ScrollingSelectorBox>
        </StackPanel>
 
        <!-- Buttons -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Grid.Row="2">

            <components:ButtonOptionBox OptionModel="{Binding Path=TestEffectModel}"
                                          Width="70"
                                          Margin="10,0,10,0"/>

            <components:ButtonOptionBox OptionModel="{Binding Path=RemoveButtonModel}"
                                 Width="70"/>  
        </StackPanel>
    </Grid>
</editgameoptions:SoundEffectEditorBase>
