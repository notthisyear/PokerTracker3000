<UserControl x:Class="PokerTracker3000.WpfComponents.EditGameOptions.FileAndSpeechSoundEffectEditContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:PokerTracker3000.WpfComponents"
             xmlns:editgameoptions="clr-namespace:PokerTracker3000.WpfComponents.EditGameOptions"
             xmlns:validation="clr-namespace:PokerTracker3000.WpfComponents.ValidationRules"
             xmlns:converters="clr-namespace:PokerTracker3000.WpfComponents.Converters"
             xmlns:sound="clr-namespace:PokerTracker3000.GameSession.Sound">
    <Grid>
        <Grid.Resources>
            <converters:ObjectToDataTypeConverter x:Key="objectToDataTypeConverter" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Headline -->
        <TextBlock FontSize="10"
                Opacity="0.8"
                HorizontalAlignment="Center"
                FontWeight="Bold">
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MainTextBlockStyle}">
                    <Setter Property="Text" Value="Sound effect from file" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=SoundEffect, Converter={StaticResource objectToDataTypeConverter}}"
                                     Value="{x:Type sound:SpeechSoundEffect}">
                            <Setter Property="Text" Value="Synthesized speech sound effect" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Main content -->
        <StackPanel Orientation="Horizontal"
                    Grid.Row="1">

            <!-- Sound effects options -->
            <StackPanel Orientation="Vertical">
                
                <!-- Headline -->
                <TextBlock Style="{StaticResource MainTextBlockStyle}"
                           Text="Effect options"
                           HorizontalAlignment="Left"
                           Height="20"/>
                <Grid>
                    <!-- Options -->
                    <Border Padding="5"
                                CornerRadius="5"
                                BorderThickness="0"
                                Margin="0,0,0,20"
                                MinWidth="270">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource PrimaryColorRaw}" Opacity="0.4" />
                        </Border.Background>
                        <ItemsControl ItemsSource="{Binding Path=SoundEffect.EffectOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <editgameoptions:SoundEditOption DisplayName="{Binding Path=Name}"
                                                                         MaxTextLength="40">

                                        <editgameoptions:SoundEditOption.Style>
                                            <Style TargetType="{x:Type editgameoptions:SoundEditOption}">
                                                <Setter Property="IsSelected" Value="False" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Path=IsSelected}" Value="True" />
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ItemsControl}}, Path=DataContext.IsActive}"
                                                                           Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <MultiDataTrigger.Setters>
                                                            <Setter Property="IsSelected" Value="True" />
                                                        </MultiDataTrigger.Setters>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </editgameoptions:SoundEditOption.Style>
                                    </editgameoptions:SoundEditOption>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Change/remove/test buttons -->
                    <Border  Background="{StaticResource BackgroundColorDarkerShade}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 CornerRadius="5"
                                 Padding="5">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Opacity" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=ShowChangeRemoveTestEffectOptions}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource animateOpacityToOne}" />
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard Storyboard="{StaticResource animateOpacityToZero}" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <components:ButtonOptionBox OptionModel="{Binding Path=ChangeEffectOptionModel}"
                                                            Width="40"
                                                            Margin="0,0,10,0"
                                                            FontSize="9"/>
                            <components:ButtonOptionBox OptionModel="{Binding Path=RemoveEffectOptionModel}"
                                                            Width="40"
                                                            Margin="0,0,10,0"
                                                            FontSize="9"/>
                            <components:ButtonOptionBox OptionModel="{Binding Path=TestEffectOptionModel}"
                                                            Width="40"
                                                            FontSize="9"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!--Add options-->
            <components:ButtonOptionBox OptionModel="{Binding Path=AddOptionModel}"
                                            Width="70"
                                            VerticalAlignment="Top"
                                            Margin="20,20,20,20"/>

            <!-- Multiple options scroller -->
            <StackPanel Orientation="Horizontal"
                             VerticalAlignment="Top"
                             HorizontalAlignment="Left"
                            Margin="0,20,0,0">
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Opacity" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=ShowMultipleOptionsScroller}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource animateOpacityToOne}" />
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource animateOpacityToZero}" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Style="{StaticResource MainTextBlockStyle}"
                               Text="Mode:"
                               Margin="0,0,5,0"
                               Opacity="0.7"
                               FontSize="11"/>
                <components:ScrollingSelectorBox x:Name="multipleOptionModeScroller"
                                     VerticalAlignment="Center"
                                     Options="{Binding Path=AvailableMultipleOptionModeTypes}"
                                     NavigatorRelay="{Binding Path=ScrollerNavRelay}"
                                     Foreground="{StaticResource MainTextColor}">
                    <components:ScrollingSelectorBox.Style>
                        <Style TargetType="{x:Type components:ScrollingSelectorBox}">
                            <Setter Property="CenterItemColor" Value="{StaticResource MainTextColor}" />
                            <Setter Property="Foreground" Value="{StaticResource MainTextMutedColor}" />
                            <Setter Property="OptionTextAlignment" Value="Left" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="VerticalSpacing" Value="20" />
                            <Setter Property="NextAndPreviousOpacity" Value="0.0" />
                            <Setter Property="WrapAtEnds" Value="False" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Path=IsActive}" Value="True" />
                                        <Condition Binding="{Binding Path=ScrollerSelectable.IsSelected}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.Setters>
                                        <Setter Property="CenterItemColor" Value="{StaticResource MainHighlightColor}" />
                                        <Setter Property="NextAndPreviousOpacity" Value="0.1" />
                                    </MultiDataTrigger.Setters>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </components:ScrollingSelectorBox.Style>
                </components:ScrollingSelectorBox>
            </StackPanel>
        </StackPanel>

        <!-- Rename field -->
        <Border  Background="{StaticResource BackgroundColorDarkerShade}"
                     Grid.Row="1"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"
                     CornerRadius="5"
                     Padding="5"
                     Height="50"
                     Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Grid}},
                                Path=ActualWidth,
                                Converter={StaticResource scaleNumberConverter},
                                ConverterParameter=*0.85}">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=ShowRenameEffectField}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource animateOpacityToOne}" />
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource animateOpacityToZero}" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Vertical">
                <TextBlock Style="{StaticResource MainTextBlockStyle}"
                               Foreground="{StaticResource PrimaryColor}"
                               HorizontalAlignment="Center"
                               Text="SOUND EFFECT NAME"
                               FontWeight="Bold"
                               FontSize="10"/>
                <TextBox  x:Name="renameEffectBox"
                              Style="{StaticResource MainTextBoxStyle}"
                              HorizontalAlignment="Stretch"
                              Height="30"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center">
                    <TextBox.Text>
                        <Binding Path="SoundEffect.RawName"
                                     UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <validation:TextLengthValidationRule Min="1" Max="25" FieldName="Name"/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Grid.Row="2">

            <components:ButtonOptionBox OptionModel="{Binding Path=RenameEffectModel}"
                                            Width="70"
                                            Margin="0,0,10,0"/>

            <components:ButtonOptionBox OptionModel="{Binding Path=RemoveEffectModel}"
                                            Width="70"/>
        </StackPanel>
    </Grid>
</UserControl>